{
  "name": "kebab",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "把 AI 导出的 HTML 原型、界面截图说明、流程图串成一份带导航树的静态站点",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node src/build.js",
    "doctor": "node src/doctor.js",
    "test": "node --test --test-isolation=none",
    "editor:build": "esbuild src/editor/ui/main.js --bundle --format=esm --minify --define:__VUE_OPTIONS_API__=false --define:__VUE_PROD_DEVTOOLS__=false --define:__VUE_PROD_HYDRATION_MISMATCH_DETAILS__=false --outfile=src/editor/ui/dist/ui.js",
    "edit": "npm run editor:build && node src/editor/server.js"
  },
  "dependencies": {
    "@milkdown/crepe": "^7.22.1",
    "markdown-it": "^14.1.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.0"
  }
}
